# Headless test harness for RoWorld -> Frontline Conquest parity checks.
extends RefCounted

const PASS := "pass"
const FAIL := "fail"
const MISSING := "missing"
const INTENTIONAL := "intentional"

var results: Array = []  # {suite, upstream, name, status, detail}
var _suite := ""
var _upstream := ""

func section(suite: String, upstream_file: String) -> void:
	_suite = suite
	_upstream = upstream_file
	print("")
	print("== %s  (%s) ==" % [suite, upstream_file])

func _add(name: String, status: String, detail: String) -> void:
	var row := {"suite": _suite, "upstream": _upstream, "name": name, "status": status, "detail": detail}
	results.append(row)
	var tags := {"pass": "  ok  ", "fail": "FAIL  ", "missing": "MISS  ", "intentional": "INTL  "}
	var tag: String = tags[status]
	if detail == "":
		print("%s %s" % [tag, name])
	else:
		print("%s %s  --  %s" % [tag, name, detail])

func ok(name: String, detail := "") -> void:
	_add(name, PASS, detail)

func fail(name: String, detail: String) -> void:
	_add(name, FAIL, detail)

func missing(name: String, what: String) -> void:
	_add(name, MISSING, what)

func intentional(name: String, detail: String) -> void:
	_add(name, INTENTIONAL, detail)

func expect(cond: bool, name: String, detail := "") -> void:
	if cond:
		ok(name, detail)
	else:
		fail(name, detail if detail != "" else "assertion failed")

func expect_eq(got, want, name: String) -> void:
	if got == want:
		ok(name, str(got))
	else:
		fail(name, "got %s, want %s" % [str(got), str(want)])

func expect_near(got: float, want: float, eps: float, name: String) -> void:
	if abs(got - want) <= eps:
		ok(name, "got %s (want %s)" % [str(got), str(want)])
	else:
		fail(name, "got %s, want %s (eps %s, delta %s)" % [str(got), str(want), str(eps), str(got - want)])

func count(status: String) -> int:
	var n := 0
	for r in results:
		if r.status == status:
			n += 1
	return n

func write_parity_md(path: String) -> void:
	var lines: PackedStringArray = PackedStringArray()
	lines.append("# RoWorld → Frontline Conquest parity")
	lines.append("")
	lines.append("Generated by `tests/run_upstream_tests.gd` (headless). Upstream is lukechatton/roworld @ ae7a350 (fork ruihan12/roworldgodot).")
	lines.append("")
	var n_pass := count(PASS)
	var n_fail := count(FAIL)
	var n_miss := count(MISSING)
	var n_intl := count(INTENTIONAL)
	var n_all := results.size()
	lines.append("## Summary")
	lines.append("")
	lines.append("| Status | Count |")
	lines.append("| --- | ---: |")
	lines.append("| pass | %d |" % n_pass)
	lines.append("| fail (unexpected mismatch) | %d |" % n_fail)
	lines.append("| missing (pending / no API yet) | %d |" % n_miss)
	lines.append("| intentional deviation (not a bug) | %d |" % n_intl)
	lines.append("| **total cases** | **%d** |" % n_all)
	lines.append("")
	lines.append("## Intentional deviations")
	lines.append("")
	lines.append("These are required port behaviour and must not be treated as bugs. Tests in this section check that the port still has them.")
	lines.append("")
	lines.append("| Deviation | Port value | Upstream (for reference) |")
	lines.append("| --- | --- | --- |")
	lines.append("| Nuke range (fraction of map land width) | Atom 0.5265, Mega 0.5558, H 0.585, Scatter 0.6435, MIRV 1.3 | no launch-range limit on bombs (`launch_range` is 0 except shell 45 and airstrike 156) |")
	lines.append("| ICBM toggle (key I, slot after MIRV) | +10% of the launched bomb's cost, whole-map range | not present |")
	lines.append("| MIRV pattern | bus flies to the aimed point, then branches; fallout only inside real warhead blast circles | up to 350 warheads spread 1500/K_LIN around the aim, on the target's land |")
	lines.append("| Blast radii (tiles), ×2.8 for 1792×1600 (`BLAST_S = W/640 = 2.8`) | Atom 19.6, H 70, MIRV warhead 8.4, Mega 42, Scatter 19.6 | full-size inner/outer: Atom 12/30, H 80/100, warhead 12/18, Mega 24/60, Scatter 12/30 |")
	lines.append("| Nuke flight speed | 1.5× (short shots) up to 2.5× (≥ 1000 tiles) on a custom missile clock (`SimArsenal.DT_TICK` per sim tick), not the upstream Bezier / tiles-per-tick table | 10 / 10 / 15 / 22 / 10 / 10 full-size tiles per tick (atom / H / MIRV / warhead / mega / scatter) |")
	lines.append("| Antarctica | present as white snow (terrain code 4), movement/conquest/build use plains rules; no impassable ice (`0x9F`). No capital. | World Antarctica / ice tiles |")
	lines.append("| Organic borders | per-tile speed factor clamped to 0.9–1.1× (mean 1.0) | no 0.9–1.1 organic speed factor |")
	lines.append("| Troop cap | `5000 + 6200 * (tiles * tile_norm)^0.41 + 25000` per city level; ~30k for a 30-tile (old 640×352) country, ~200k Mali-size | `2 * (fullTiles^0.6 * 1000 + 50000) + 250000` per city level |")
	lines.append("| Pacing levers (~20 min matches) | `gold_mult = 0.85` (85 / 42.5 gold per tick), `growth_mult = 0.8` (troop income 80% of the upstream rate) | gold 100 / 50 per tick; growth_mult 1.0 |")
	lines.append("| Fallout lifetime | fallout is stamped at 60 s and decays away (`fallout_t` ticks down, cleared at 0) | source fallout stays until the tile is recaptured (no 60 s decay) |")
	lines.append("| HUD attack shares | stops 10 / 25 / 35 / 50 / 75 %, default 25% (`share_i = 1`). `SimRules.DEFAULT_ATTACK_RATIO = 0.2` is only the sim fallback when an order carries no ratio. | UICtx.RATIO_STOPS / DEFAULT_RATIO 25%; Rules.DEFAULT_ATTACK_RATIO 0.2 |")
	lines.append("")
	lines.append("## Unexpected mismatches (possible port bugs or leftover tweaks)")
	lines.append("")
	var any_fail := false
	for r in results:
		if r.status == FAIL:
			if not any_fail:
				lines.append("| Suite | Case | Detail |")
				lines.append("| --- | --- | --- |")
			any_fail = true
			lines.append("| %s | %s | %s |" % [_md(r.suite), _md(r.name), _md(r.detail)])
	if not any_fail:
		lines.append("_None this run._")
	lines.append("")
	lines.append("## Missing / pending (function not wired or needs a live Sim)")
	lines.append("")
	var any_miss := false
	for r in results:
		if r.status == MISSING:
			if not any_miss:
				lines.append("| Upstream test | Case | What's missing |")
				lines.append("| --- | --- | --- |")
			any_miss = true
			lines.append("| `%s` | %s | %s |" % [_md(r.upstream), _md(r.name), _md(r.detail)])
	if not any_miss:
		lines.append("_None this run._")
	lines.append("")
	lines.append("## Upstream test → port status")
	lines.append("")
	lines.append("| Upstream file | Case | Status | Notes |")
	lines.append("| --- | --- | --- | --- |")
	for r in results:
		lines.append("| `%s` | %s | %s | %s |" % [_md(r.upstream), _md(r.name), r.status, _md(r.detail)])
	lines.append("")
	lines.append("## Skipped upstream tests (not gameplay / out of scope)")
	lines.append("")
	lines.append("Roblox server, datastore, analytics, lobby, shop, cosmetics, UI-frame, net, soundtrack, purchases, Stars, tutorial, vote, party, offers, admin, and other client-shell tests are not ported: `admin_check`, `analytics`, `cosmetics`, `ds_gate`, `fix_server`, `fix_settings`, `fix_ui_frame`, `fresh_servers`, `gameplayfixer_ui`, `handoff`, `hud_frame_cache`, `lobbies`, `lobby_clock`, `lobby_service`, `map2d_render`, `map_surface_repaint`, `net_*`, `offers`, `pacer`, `party`, `polishfix_*`, `prices` (Robux), `purchases`, `quick_play`, `r2fix_server_settings`, `server_perf`, `shop`, `signal_test`, `soundtrack`, `spectate`, `stars`, `takeover*`, `team_lobbies`, `teams`, `trail_budget`, `tray_fit`, `tutorial`, `ui_*`, `uikit_theme`, `uiscreens_logic`, `vote_start`, `wake_route`, `world_places`.")
	lines.append("")
	var text := "\n".join(lines) + "\n"
	var abs_path := path
	if abs_path.begins_with("res://"):
		abs_path = ProjectSettings.globalize_path(abs_path)
	var f := FileAccess.open(abs_path, FileAccess.WRITE)
	if f == null:
		push_error("could not write %s: %s" % [abs_path, error_string(FileAccess.get_open_error())])
		return
	f.store_string(text)
	f.close()
	print("wrote %s" % abs_path)

func _md(s: String) -> String:
	return s.replace("|", "\\|").replace("\n", " ")
