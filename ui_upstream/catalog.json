 "blurbs": {
  "city": {
   "value": "Raises your troop cap by {city}. Joins the road network.",
   "ref": "src/client/UI/UIRules.luau:89"
  },
  "port": {
   "value": "Coastal. Sends trade ships for gold and builds warships.",
   "ref": "src/client/UI/UIRules.luau:90"
  },
  "factory": {
   "value": "Road hub. Trucks pay gold at every stop they pass.",
   "ref": "src/client/UI/UIRules.luau:91"
  },
  "defense": {
   "value": "Land within {def_r} tiles costs attackers {def_mag}x the troops and {def_cost}x the time.",
   "ref": "src/client/UI/UIRules.luau:92"
  },
  "sam": {
   "value": "Shoots down bombs aimed within {sam_r} tiles. MIRV warheads can't be stopped.",
   "ref": "src/client/UI/UIRules.luau:93"
  },
  "silo": {
   "value": "Required to launch nuclear weapons.",
   "ref": "src/client/UI/UIRules.luau:94"
  },
  "warship": {
   "value": "Patrols where you send it: sinks transports, then warships, and captures trade ships. Heals at your ports.",
   "ref": "src/client/UI/UIRules.luau:95"
  },
  "atom": {
   "value": "Small blast that wipes troops and structures, leaving fallout.",
   "ref": "src/client/UI/UIRules.luau:96"
  },
  "hydrogen": {
   "value": "Massive blast. Anything inside is erased.",
   "ref": "src/client/UI/UIRules.luau:97"
  },
  "mirv": {
   "value": "Splits into up to {mirv_n} warheads that rain over one nation.",
   "ref": "src/client/UI/UIRules.luau:98"
  },
  "artillery": {
   "value": "Shells every enemy within {art_r} tiles on its own: their troops, and the structures it reaches.",
   "ref": "src/client/UI/UIRules.luau:99"
  },
  "airfield": {
   "value": "Flies Air Strikes on any spot within {air_r} tiles. Rearms in {air_s} s.",
   "ref": "src/client/UI/UIRules.luau:100"
  },
  "railgun": {
   "value": "Fires at any spot on the map. Reloads in {rail_s} s.",
   "ref": "src/client/UI/UIRules.luau:101"
  },
  "mega": {
   "value": "Twice an Atom Bomb's radius: four times the ground, gone.",
   "ref": "src/client/UI/UIRules.luau:102"
  },
  "scatter": {
   "value": "An Atom Bomb with {scat_lo} to {scat_hi} warheads that come down around it.",
   "ref": "src/client/UI/UIRules.luau:103"
  },
  "airstrike": {
   "value": "Bombs a {air_blast}-tile circle: kills troops and wrecks structures. No SAM can stop it.",
   "ref": "src/client/UI/UIRules.luau:104"
  },
  "slug": {
   "value": "A slug that takes a level off every structure it hits. Nothing intercepts it.",
   "ref": "src/client/UI/UIRules.luau:105"
  },
  "reinforce": {
   "value": "Brings a fifth of your troop cap at once. Ready again every {rein_s} s.",
   "ref": "src/client/UI/UIRules.luau:106"
  }
 },
